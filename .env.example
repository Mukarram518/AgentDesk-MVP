# ==========================================
# AgentDesk MVP - Environment Configuration
# ==========================================

# Application
PROJECT_NAME="AgentDesk MVP"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5434
POSTGRES_DB=agentdesk
# Async connection URL for FastAPI / SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/agentdesk
# Sync connection URL for Alembic migrations
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5434/agentdesk

# Redis (Infrastructure foundation)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Provider (Groq)
# Required server-side API key for Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Embeddings (local for dev/tests, api for memory-constrained production)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
# Output dimension for all-MiniLM-L6-v2 is 384
EMBEDDING_DIMENSION=384
# Hosted inference endpoint and API key (used when EMBEDDING_PROVIDER=api)
EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction
EMBEDDING_API_KEY=your_huggingface_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
